{
    "name": "tagadvance/elephant-retrying",
    "description": "This is a port of the guava-retrying module to allow for the creation of configurable retrying strategies for an arbitrary function call, such as something that talks to a remote service with flaky uptime.",
    "type": "library",
    "license": "Apache-2.0",
    "authors": [
        {
            "name": "Tag",
            "email": "tagadvance+github.com@gmail.com"
        }
    ],
    "require": {
        "php": "^8.4",
        "respect/validation": "^2.5"
    },
    "require-dev": {
        "friendsofphp/php-cs-fixer": "^3.95",
        "mockery/mockery": "^1.6",
        "phpstan/phpstan": "^2.2",
        "phpunit/phpunit": "^13.3"
    },
    "autoload": {
        "psr-4": {
            "": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "": ["tests/unit/", "tests/integration/"]
        }
    }
}
