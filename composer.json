{
    "name": "tagadvance/elephant-retrying",
    "description": "A port of guava-retrying providing configurable retry strategies for arbitrary PHP calls.",
    "type": "library",
    "keywords": [
        "retry",
        "backoff",
        "resilience",
        "fault-tolerance",
        "guava-retrying"
    ],
    "license": "Apache-2.0",
    "authors": [
        {
            "name": "Tag",
            "email": "tagadvance+github.com@gmail.com"
        }
    ],
    "require": {
        "php": "^8.4",
        "respect/validation": "^2.5"
    },
    "require-dev": {
        "friendsofphp/php-cs-fixer": "^3.95",
        "mockery/mockery": "^1.6",
        "phpstan/phpstan": "^2.2",
        "phpunit/phpunit": "^13.3"
    },
    "autoload": {
        "psr-4": {
            "tagadvance\\": "src/tagadvance/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "tagadvance\\": ["tests/unit/tagadvance/", "tests/integration/tagadvance/"]
        }
    }
}
